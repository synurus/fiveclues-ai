# 다섯고개 백엔드 환경변수
#
#   cp apps/backend/.env.example apps/backend/.env
#
# .env 는 커밋되지 않는다(.gitignore). Vercel에 배포할 땐 이 값들을 프로젝트의
# Environment Variables 설정에 그대로 넣는다.

# ─────────────────────────────────────────────
# 필수 — 없으면 서버가 요청 시점에 에러를 낸다
# ─────────────────────────────────────────────

# 라운드 사이 상태(제시어)를 클라이언트가 들고 다니는 세션 토큰을 암호화하는 키.
# 32바이트를 base64로. 생성: openssl rand -base64 32
# 없으면 /game/start·/game/guess 호출 즉시 에러로 죽는다(routes/gameToken.ts).
GAME_TOKEN_SECRET=

# 묘사·추측 판정용 LLM. OpenAI 호환 엔드포인트면 어디든 된다(기본값은 Groq
# 무료 티어). AI 자동플레이(bot/autoPlay.ts)도 같은 값을 쓴다.
#   BOT_BASE_URL  Groq 기준 https://api.groq.com/openai/v1 (비우면 이 기본값)
#   BOT_API_KEY   해당 엔드포인트의 API 키
#   BOT_MODEL     비우면 openai/gpt-oss-120b
BOT_BASE_URL=
BOT_API_KEY=
BOT_MODEL=

# ─────────────────────────────────────────────
# 자가개선 루프 (github/feedbackIssue.ts, .github/workflows/self-improve*.yml)
# ─────────────────────────────────────────────
# 피드백을 GitHub Issue로 쌓는 데 쓰는 토큰. fine-grained PAT, 이 레포 하나에만
# Issues: write 권한만 줄 것 — classic PAT의 repo 스코프는 과하다.
GITHUB_FEEDBACK_TOKEN=

# "owner/repo" 형식. 예: synurus/fiveclues-ai
GITHUB_REPO=

# ─────────────────────────────────────────────
# 선택
# ─────────────────────────────────────────────
# 로컬 개발용 포트. 기본 3000. Vercel 배포에선 안 쓰인다(서버리스 함수라
# 포트 개념이 없다).
PORT=3000

# CORS 허용 origin. 비우면 '*'(전부 허용) — 이 API는 쿠키/인증 헤더를 안 써서
# '*'로 열어둬도 위험하지 않다. 프론트와 API를 Vercel에서 같은 도메인으로
# 서빙하면(권장) 이 값 자체가 필요 없다.
CORS_ORIGIN=

# AI 자동플레이(bot/autoPlay.ts) 전용 — 제미나이 추측자 비교 실험(2026-09-17).
# 이 셋을 안 채우면 아래 자가개선 분석용 SELFIMPROVE_BOT_*를 대신 재사용한다 —
# 굳이 새 키를 안 만들어도 됨(스카이 선택). 그마저도 없으면 실험이 꺼지고 항상
# Groq(BOT_*)만 추측한다. 채워두면(또는 SELFIMPROVE_BOT_*가 있으면) "그 실행의
# 첫 판"만 추측+소감을 이 엔드포인트가 대신한다 — 힌트 생성(BOT_*)은 안 바뀐다.
# (2026-09-26 이전엔 KST 시간대로도 제한했었는데, GitHub가 예약 실행을 몇 시간씩
# 늦추면서 "몇 시에 실행되느냐"가 의도와 무관해져 시간대 제한을 없앴다 —
# autoPlay.ts의 GUESSER_OVERRIDE 주석 참고. 예산은 이제 "실행 횟수 × 판당 2~3콜"로
# 계산한다 — 지금 스케줄(하루 5번)이면 propose.mjs 1콜까지 합쳐 11~16콜로, 제미나이
# 무료 티어 하루 20건(RPD) 안이다.)
AUTOPLAY_GUESSER_BOT_BASE_URL=
AUTOPLAY_GUESSER_BOT_API_KEY=
AUTOPLAY_GUESSER_BOT_MODEL=
