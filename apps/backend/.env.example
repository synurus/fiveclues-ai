# 이 파일을 .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
# .env 는 .gitignore 에 들어 있어 커밋되지 않는다. 키를 절대 커밋하지 말 것.

# Alibaba Token Plan 콘솔 → Plan-Specific API Key
BOT_API_KEY=

# Alibaba Token Plan 콘솔 → Plan Exclusive Base URL → "Anthropic API Protocol Compatible"
# SDK 가 이 뒤에 /v1/messages 를 붙여 호출한다.
BOT_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic

# 이 엔드포인트가 서빙하는 모델 이름. 콘솔에서 확인해 채운다.
# (Anthropic 프로토콜 호환일 뿐 모델은 Anthropic 것이 아니므로 claude-* 가 아닐 수 있다)
BOT_MODEL=
