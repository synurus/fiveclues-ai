# 다섯고개 백엔드 환경변수
#
#   cp apps/backend/.env.example .env      (저장소 맨 위에 둔다 — 2026-09-30부터 .env는 맨 위 하나, src/env.ts가 읽음)
#
# .env 는 커밋되지 않는다(.gitignore). Vercel에 배포할 땐 이 값들을 프로젝트의
# Environment Variables 설정에 그대로 넣는다.

# ─────────────────────────────────────────────
# 필수 — 없으면 서버가 요청 시점에 에러를 낸다
# ─────────────────────────────────────────────

# 라운드 사이 상태(제시어)와 판 결과(피드백용 result 토큰)를 클라이언트가 들고 다니는
# 토큰을 암호화하는 키. 바꾸면 진행 중인 판과 아직 안 보낸 피드백이 무효가 된다.
# 32바이트를 base64로. 생성: openssl rand -base64 32
# 없으면 /game/start·/game/guess 호출 즉시 에러로 죽는다(routes/gameToken.ts).
GAME_TOKEN_SECRET=

# 묘사·추측 판정용 LLM. OpenAI 호환 엔드포인트면 어디든 된다(기본값은 Groq
# 무료 티어). AI 자동플레이(bot/autoPlay.ts)도 같은 값을 쓴다.
#   BOT_BASE_URL  Groq 기준 https://api.groq.com/openai/v1 (비우면 이 기본값)
#   BOT_API_KEY   해당 엔드포인트의 API 키
#   BOT_MODEL     비우면 openai/gpt-oss-120b
BOT_BASE_URL=
BOT_API_KEY=
BOT_MODEL=

# 출제 모델 체인(2026-09-27, bot/wordGuessBot.ts의 HINT_CHAIN). 주력 모델이 하루
# 한도·과부하에 걸리면 다음 모델로 넘어간다. 비우면 코드의 기본 순서를 쓴다.
#   형식: "groq:모델,gemini:모델,..." (앞에 있을수록 먼저)
#   groq 항목은 위 BOT_API_KEY, gemini 항목은 아래 GEMINI_API_KEY를 쓴다.
HINT_MODEL_CHAIN=
# 제미나이 보조 출제용 키(Google AI Studio). 비우면 SELFIMPROVE_BOT_API_KEY를 재사용하고,
# 그것도 없으면 제미나이 항목은 체인에서 빠진다(Groq 모델끼리만 넘어감).
# ⚠️ 무료 할당량은 EEA·스위스·영국 이용자에게 쓸 수 없어서 그 지역 접속엔 자동으로 안 쓴다.
GEMINI_API_KEY=

# ─────────────────────────────────────────────
# 자가개선 루프 (github/feedbackIssue.ts, .github/workflows/self-improve*.yml)
# ─────────────────────────────────────────────
# 피드백을 GitHub Issue로 쌓는 데 쓰는 토큰. fine-grained PAT, 이 레포 하나에만
# Issues: write 권한만 줄 것 — classic PAT의 repo 스코프는 과하다.
GITHUB_FEEDBACK_TOKEN=

# "owner/repo" 형식. 예: synurus/fiveclues-ai
GITHUB_REPO=

# ─────────────────────────────────────────────
# 선택
# ─────────────────────────────────────────────
# 로컬 개발용 API 포트. 기본 3000 — 바꾸면 apps/frontend/vite.config.ts의 /game 프록시도
# 같이 바꿀 것. Vercel 배포에선 안 쓰인다(서버리스 함수라 포트 개념이 없다).
# (PORT가 아닌 이유는 server.ts 주석 참고)
API_PORT=3000

# CORS 허용 origin. 비우면 '*'(전부 허용) — 이 API는 쿠키/인증 헤더를 안 써서
# '*'로 열어둬도 위험하지 않다. 프론트와 API를 Vercel에서 같은 도메인으로
# 서빙하면(권장) 이 값 자체가 필요 없다.
CORS_ORIGIN=

# AI 자동플레이(bot/autoPlay.ts) 전용 — 제미나이 추측자 비교 실험(2026-09-17).
# 이 셋을 안 채우면 아래 자가개선 분석용 SELFIMPROVE_BOT_*를 대신 재사용한다 —
# 굳이 새 키를 안 만들어도 됨(흑기사 선택). 그마저도 없으면 실험이 꺼지고 항상
# Groq(BOT_*)만 추측한다. 채워두면(또는 SELFIMPROVE_BOT_*가 있으면) "그 실행의
# 첫 판"만 추측+소감을 이 엔드포인트가 대신한다 — 힌트 생성(출제 모델 체인)은 안 바뀐다.
# (2026-09-26 이전엔 KST 시간대로도 제한했었는데, GitHub가 예약 실행을 몇 시간씩
# 늦추면서 "몇 시에 실행되느냐"가 의도와 무관해져 시간대 제한을 없앴다 —
# autoPlay.ts의 GUESSER_OVERRIDE 주석 참고. 예산은 이제 "실행 횟수 × 판당 2~3콜"로
# 계산한다 — 지금 스케줄(하루 5번)이면 propose.mjs 1콜까지 합쳐 11~16콜로, 제미나이
# 무료 티어 하루 20건(RPD) 안이다.)
# 모델은 비우면 gemini-3.5-flash(2026-09-28 — 3.8-flash는 자가개선·묘사 세트 생성 전용).
AUTOPLAY_GUESSER_BOT_BASE_URL=
AUTOPLAY_GUESSER_BOT_API_KEY=
AUTOPLAY_GUESSER_BOT_MODEL=

# 묘사 세트 사전 생성(bot/pregenHints.ts, npm run pregen -w backend). 키는 GEMINI_API_KEY →
# SELFIMPROVE_BOT_API_KEY 순. 전부 비우면 기본값(모델 gemini-3.8-flash, PT 하루 16회,
# 한 번 실행 8회, 묶음 8단어). 로컬에서 돌려도 scripts/hintsets/usage.json에 기록된다.
PREGEN_MODEL=
PREGEN_DAILY_CALLS=
PREGEN_RUN_CALLS=
PREGEN_BATCH=
# 주 모델이 과부하·한도일 때 대체 모델(기본 gemini-3.1-flash-lite, PT 하루 48회·실행당 16회)
PREGEN_FALLBACK_MODEL=
PREGEN_FALLBACK_DAILY_CALLS=
PREGEN_FALLBACK_RUN_CALLS=
