# Zeteo 백엔드 환경변수
#
#   cp apps/backend/.env.example apps/backend/.env
#
# .env 는 커밋되지 않는다(.gitignore). 값이 필요한 사람에게는 파일로 직접 전달한다.
# 실제 사용처는 각 항목의 주석에 파일:줄 로 적어뒀다.

# ─────────────────────────────────────────────
# 필수 — 없으면 서버가 부팅 시점에 죽는다
# ─────────────────────────────────────────────
# db/supabase.ts 가 import 되는 순간(서버 부팅) 검사한다. 값이 없으면 첫 쿼리까지
# 기다리지 않고 그 자리에서 throw 한다 — 원인 찾기가 쉬우라고 일부러 그렇게 해뒀다.

# Supabase 프로젝트 URL. 대시보드 Project Settings → API 의 Project URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ anon 키가 아니라 service_role 키다. RLS 를 통과하는 서버 전용 키이므로
#    절대 커밋하거나 프론트엔드에 넣지 말 것. 같은 페이지의 service_role 항목.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# 봇 — 어느 프로바이더를 쓰느냐에 따라 필요한 값이 갈린다
# ─────────────────────────────────────────────
# 'openai' 면 OpenAI 경로, 그 외(미설정 포함)는 anthropic 경로다. (bot/llm.ts:43)
#
# ⚠️ 이 값이 최종 결정권자가 아니다. 우선순위:
#      apps/backend/.bot-provider 파일 > ADMIN_KEY 로 호출한 /x/provider > 이 환경변수 > anthropic
#    운영 중에 재배포 없이 프로바이더를 바꾸는 길이 따로 있다는 뜻이다.
BOT_PROVIDER=anthropic

# --- anthropic 경로 (BOT_PROVIDER 가 openai 가 아닐 때 셋 다 필수) ---
# 셋 중 하나라도 비면 봇이 첫 발언을 시도하는 순간 실패한다. 서버는 안 죽고 로그만 남긴 뒤
# 페이즈 타이머가 이어받는다 — 즉 "봇이 말을 안 하는 게임"이 된다.
#
# 세 값 모두 Alibaba Token Plan 콘솔에서 나온다:
#   BOT_API_KEY  ← Plan-Specific API Key
#   BOT_BASE_URL ← Plan Exclusive Base URL 의 "Anthropic API Protocol Compatible" 주소.
#                  SDK 가 이 뒤에 /v1/messages 를 붙여 호출하므로 그 경로는 빼고 넣는다.
#   BOT_MODEL    ← 그 엔드포인트가 실제로 서빙하는 모델 이름. Anthropic 프로토콜과
#                  호환될 뿐 모델 자체는 Anthropic 것이 아니라서 claude-* 가 아닐 수 있다.
BOT_API_KEY=
BOT_BASE_URL=
BOT_MODEL=

# --- openai 경로 (BOT_PROVIDER=openai 일 때 필수) ---
# 발급처: OpenRouter
GPT_API_KEY=
GPT_MODEL=
# 기본값 https://openrouter.ai/api/v1 — 다른 게이트웨이를 쓸 때만 채운다. (bot/llm.ts:182)
GPT_BASE_URL=
# reasoning effort 최고 단계. 기본값 max. 모델을 바꿀 때 코드를 안 고치려고 빼둔 값이다.
GPT_EFFORT_MAX=max

# ─────────────────────────────────────────────
# 선택 — 없어도 게임은 정상 동작한다
# ─────────────────────────────────────────────
# HTTP 포트. 기본 3000. (index.ts:861)
PORT=3000

# 프로바이더 전환용 관리 라우트(/x/provider)의 열쇠. (bot/admin-route.ts:36)
# ⚠️ 비워두면 그 라우트 자체가 없는 것으로 취급된다(404). 켜려면 길고 무작위한 값을 넣을 것 —
#    틀린 열쇠에도 403 이 아니라 404 를 주도록 돼 있다("여기 뭔가 있다"를 안 알려주려고).
ADMIN_KEY=

# 판이 끝나면 로그를 보낼 Discord 웹훅. 없으면 조용히 건너뛴다. (db/webhook.ts:3)
LOG_WEBHOOK_URL=

# ─────────────────────────────────────────────
# 여기에 넣지 않는 것
# ─────────────────────────────────────────────
# RAILWAY_GIT_COMMIT_SHA — Railway 가 배포마다 자동으로 주입한다. 로컬 실행에선 없는 게
# 정상이고(games.bot_commit_sha 가 null 로 남는다), 'local' 같은 값으로 채우면 판 집계에
# 섞여서 "프롬프트를 바꾼 전후" 비교가 망가진다. (db/game.ts)

# ─────────────────────────────────────────────
# 턴제 게임 API (routes/game.ts, turnServer.ts) — 실시간 게임과 별개 경로
# ─────────────────────────────────────────────
# 라운드 사이 상태(제시어)를 클라이언트가 들고 다니는 세션 토큰을 암호화하는 키.
# 32바이트를 base64로. 생성: openssl rand -base64 32
# 없으면 /game/start·/game/guess 호출 즉시 에러로 죽는다(routes/gameToken.ts).
GAME_TOKEN_SECRET=

# 턴제 서버 포트. 비우면 PORT를, 그것도 없으면 3000을 쓴다. index.ts(실시간
# 서버)와 같은 프로세스가 아니라서 같은 PORT를 그대로 써도 되고, 둘을 동시에
# 띄우려면 다른 값을 줘야 한다.
TURN_PORT=
