{
  "name": "fiveclues-ai",
  "version": "1.0.0",
  "description": "AI가 묘사하는 제시어를 맞추는 낱말 게임 — 자가개선 루프로 힌트 프롬프트가 스스로 좋아진다",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend && npm run build -w backend",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6"
  }
}
